{
  "$meta": {
    "name": "financial-os design tokens",
    "adr": "ADR-010 (draft, amends ADR-004)",
    "status": "PROPOSAL for ADR-010 — not canonical until approved by Tzeela",
    "direction": "Nordic Calm, aligned to chapter 19C per 20F §16/§21 (no purple, chapter 23 §13)",
    "theme": "light-only (Release 1)",
    "note": "Single source of truth. Tailwind config and CSS variables are generated from this file in Stage 8. Values change only through a new ADR that amends ADR-004."
  },
  "color": {
    "neutral": {
      "canvas": "#F7F6F4",
      "surface": "#FFFFFF",
      "surface-subtle": "#F0EEEB",
      "surface-sunken": "#E8E5E0",
      "overlay": "rgba(38, 34, 31, 0.40)"
    },
    "text": {
      "primary": "#26221F",
      "secondary": "#57514B",
      "tertiary": "#6B645D",
      "disabled": "#A39C94",
      "inverse": "#FFFFFF",
      "link": "#0E5A5E"
    },
    "border": {
      "subtle": "#E6E2DD",
      "default": "#D5D0C9",
      "strong": "#8C847C",
      "divider": "#E6E2DD"
    },
    "brand": {
      "50": "#E7F3F3",
      "100": "#CCE6E6",
      "600": "#0E5A5E",
      "700": "#0B484B",
      "800": "#083739"
    },
    "semantic": {
      "success": {
        "fg": "#1B6E4E",
        "bg": "#E4F3EC",
        "border": "#9ACDB6"
      },
      "warning": {
        "fg": "#8A5700",
        "bg": "#FCF1DA",
        "border": "#E8C27A"
      },
      "error": {
        "fg": "#B0233F",
        "bg": "#FBE9ED",
        "border": "#EDA6B5"
      },
      "info": {
        "fg": "#1C6698",
        "bg": "#E6F1F9",
        "border": "#A6C9E3"
      }
    },
    "financial": {
      "positive": "#1B6E4E",
      "negative": "#A33A2F",
      "neutral": "#26221F",
      "expected": "#3E5A78",
      "planned": "#6B5B3E",
      "unknown": "#6B645D"
    },
    "reliability": {
      "verified": "#1B6E4E",
      "unverified": "#6B645D",
      "needs_review": "#8A5700",
      "contradicted": "#B0233F",
      "coverage_complete": "#1B6E4E",
      "coverage_partial": "#8A5700",
      "coverage_none": "#B0233F",
      "coverage_unknown": "#6B645D",
      "coverage_stale": "#6B645D"
    },
    "interaction": {
      "hover-overlay": "rgba(38, 34, 31, 0.04)",
      "pressed-overlay": "rgba(38, 34, 31, 0.08)",
      "selected-bg": "#E7F3F3",
      "selected-border": "#0E5A5E",
      "focus-ring": "#0E5A5E",
      "disabled-bg": "#F0EEEB",
      "disabled-fg": "#A39C94"
    },
    "secondary": {
      "50": "#EDF1F5",
      "600": "#3E5A78",
      "700": "#324A63"
    },
    "accent": {
      "50": "#E3F6F6",
      "500": "#1D9CA3",
      "700": "#127278"
    }
  },
  "typography": {
    "family": {
      "base": "Heebo, system-ui, sans-serif"
    },
    "numeric": {
      "font-variant-numeric": "tabular-nums lining-nums"
    },
    "weight": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    },
    "scale": {
      "caption": {
        "size": 12,
        "line": 16,
        "weight": 400
      },
      "body-sm": {
        "size": 14,
        "line": 20,
        "weight": 400
      },
      "body": {
        "size": 16,
        "line": 24,
        "weight": 400
      },
      "label": {
        "size": 14,
        "line": 20,
        "weight": 500
      },
      "title-sm": {
        "size": 18,
        "line": 26,
        "weight": 600
      },
      "title": {
        "size": 20,
        "line": 28,
        "weight": 600
      },
      "heading": {
        "size": 24,
        "line": 32,
        "weight": 600
      },
      "display": {
        "size": 30,
        "line": 38,
        "weight": 800
      },
      "amount-lg": {
        "size": 36,
        "line": 44,
        "weight": 600
      }
    },
    "unit": "px"
  },
  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64,
    "24": 96,
    "32": 128
  },
  "radius": {
    "none": 0,
    "xs": 2,
    "sm": 4,
    "md": 10,
    "lg": 14,
    "xl": 16,
    "dot": 9999,
    "usage": {
      "badge": "sm",
      "button": "md",
      "input": "md",
      "menu": "md",
      "table": "lg",
      "card": "lg",
      "dialog": "xl",
      "drawer": "xl",
      "bottom-sheet-top": "xl",
      "dot": "status dot only; no pills (20 §14, 19C §17)"
    }
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(28, 37, 48, 0.06)",
    "2": "0 2px 8px rgba(28, 37, 48, 0.08)",
    "3": "0 8px 24px rgba(28, 37, 48, 0.12)",
    "usage": {
      "card": 1,
      "menu/popover": 2,
      "dialog/drawer/bottom-sheet": 3
    }
  },
  "border": {
    "width": {
      "default": 1,
      "strong": 2
    },
    "focus-ring": {
      "width": 2,
      "offset": 2,
      "color": "color.interaction.focus-ring"
    },
    "selected": {
      "width": 2,
      "color": "color.interaction.selected-border"
    }
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast": 150,
      "base": 200,
      "slow": 250
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "reduced-motion": "all transitions -> duration.instant, except opacity -> duration.fast"
  },
  "breakpoints": {
    "mobile-min": 320,
    "tablet": 768,
    "laptop": 1024,
    "desktop": 1280,
    "wide": 1536,
    "qa-widths": [
      320,
      360,
      375,
      390,
      768,
      1024,
      1280
    ]
  },
  "icon": {
    "library": "lucide",
    "size": {
      "sm": 16,
      "md": 20,
      "lg": 24
    },
    "stroke": 1.75,
    "touch-target": 48
  },
  "z-index": {
    "base": 0,
    "sticky": 10,
    "dropdown": 20,
    "overlay": 30,
    "drawer": 40,
    "dialog": 50,
    "toast": 60
  }
}