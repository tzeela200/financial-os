{
  "$meta": {
    "name": "financial-os design tokens",
    "adr": "ADR-004",
    "status": "canonical-immutable",
    "direction": "Nordic Calm",
    "theme": "light-only (Release 1)",
    "note": "Single source of truth. Tailwind config and CSS variables are generated from this file in Stage 8. Values change only through a new ADR that amends ADR-004."
  },
  "color": {
    "neutral": {
      "canvas": "#F5F6F7",
      "surface": "#FFFFFF",
      "surface-subtle": "#EEF1F3",
      "surface-sunken": "#E7EBEE",
      "overlay": "rgba(28, 37, 48, 0.40)"
    },
    "text": {
      "primary": "#1C2530",
      "secondary": "#4A5563",
      "tertiary": "#5F6B78",
      "disabled": "#9AA3AD",
      "inverse": "#FFFFFF",
      "link": "#2F5D7C"
    },
    "border": {
      "subtle": "#E1E5E9",
      "default": "#CDD3D9",
      "strong": "#86919C",
      "divider": "#E1E5E9"
    },
    "brand": {
      "50": "#EAF1F6",
      "100": "#D3E2EC",
      "600": "#2F5D7C",
      "700": "#244A63",
      "800": "#1B3A4E"
    },
    "semantic": {
      "success": { "fg": "#236B4B", "bg": "#E6F2EC", "border": "#9CCBB3" },
      "warning": { "fg": "#8A5A00", "bg": "#FBF1DC", "border": "#E3C07A" },
      "error":   { "fg": "#B3261E", "bg": "#FBEAE9", "border": "#EBA8A3" },
      "info":    { "fg": "#2F6690", "bg": "#E8F0F7", "border": "#A9C5DD" }
    },
    "financial": {
      "positive": "#236B4B",
      "negative": "#9C3B2E",
      "neutral": "#1C2530",
      "expected": "#4F6479",
      "planned": "#6B5B3E",
      "unknown": "#5F6B78"
    },
    "reliability": {
      "verified": "#236B4B",
      "unverified": "#5F6B78",
      "needs_review": "#8A5A00",
      "contradicted": "#B3261E",
      "coverage_complete": "#236B4B",
      "coverage_partial": "#8A5A00",
      "coverage_none": "#B3261E",
      "coverage_unknown": "#5F6B78",
      "coverage_stale": "#5F6B78"
    },
    "interaction": {
      "hover-overlay": "rgba(28, 37, 48, 0.04)",
      "pressed-overlay": "rgba(28, 37, 48, 0.08)",
      "selected-bg": "#EAF1F6",
      "selected-border": "#2F5D7C",
      "focus-ring": "#2F5D7C",
      "disabled-bg": "#EEF1F3",
      "disabled-fg": "#9AA3AD"
    }
  },
  "typography": {
    "family": { "base": "Heebo, system-ui, sans-serif" },
    "numeric": { "font-variant-numeric": "tabular-nums lining-nums" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "scale": {
      "caption":  { "size": 12, "line": 16, "weight": 400 },
      "body-sm":  { "size": 14, "line": 20, "weight": 400 },
      "body":     { "size": 16, "line": 24, "weight": 400 },
      "label":    { "size": 14, "line": 20, "weight": 500 },
      "title-sm": { "size": 18, "line": 26, "weight": 600 },
      "title":    { "size": 20, "line": 28, "weight": 600 },
      "heading":  { "size": 24, "line": 32, "weight": 600 },
      "display":  { "size": 30, "line": 38, "weight": 700 },
      "amount-lg":{ "size": 36, "line": 44, "weight": 600 }
    },
    "unit": "px"
  },
  "spacing": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "24": 96, "32": 128 },
  "radius": {
    "none": 0,
    "xs": 2,
    "sm": 4,
    "md": 6,
    "lg": 8,
    "xl": 12,
    "dot": 9999,
    "usage": {
      "badge": "sm", "button": "md", "input": "md", "table": "lg", "card": "lg",
      "dialog": "xl", "drawer": "xl", "bottom-sheet-top": "xl",
      "dot": "status dot/avatar shape only; never a component (chapter 20 §14: no fully rounded components, no pill buttons)"
    }
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(28, 37, 48, 0.06)",
    "2": "0 2px 8px rgba(28, 37, 48, 0.08)",
    "3": "0 8px 24px rgba(28, 37, 48, 0.12)",
    "usage": { "card": 1, "menu/popover": 2, "dialog/drawer/bottom-sheet": 3 }
  },
  "border": {
    "width": { "default": 1, "strong": 2 },
    "focus-ring": { "width": 2, "offset": 2, "color": "color.interaction.focus-ring" },
    "selected": { "width": 2, "color": "color.interaction.selected-border" }
  },
  "motion": {
    "duration": { "instant": 0, "fast": 120, "base": 200, "slow": 280 },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "exit": "cubic-bezier(0.3, 0, 1, 1)" },
    "reduced-motion": "all transitions -> duration.instant, except opacity -> duration.fast"
  },
  "breakpoints": {
    "mobile-min": 320,
    "tablet": 768,
    "laptop": 1024,
    "desktop": 1280,
    "wide": 1536,
    "qa-widths": [320, 360, 375, 390, 768, 1024, 1280]
  },
  "icon": {
    "library": "lucide",
    "size": { "sm": 16, "md": 20, "lg": 24 },
    "stroke": 1.75,
    "touch-target": 48
  },
  "z-index": { "base": 0, "sticky": 10, "dropdown": 20, "overlay": 30, "drawer": 40, "dialog": 50, "toast": 60 }
}
